<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:element name="abstractItem" type="xs:string" abstract="true"/>
    <xs:element name="entry">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="abstractItem"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>
