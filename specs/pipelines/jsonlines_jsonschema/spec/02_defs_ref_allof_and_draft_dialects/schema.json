{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SampleSubmission",
  "$defs": {
    "base_id": {
      "type": "object",
      "required": [
        "submission_id",
        "priority"
      ],
      "properties": {
        "submission_id": {
          "type": "string"
        },
        "priority": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "contact_info": {
      "$id": "https://example.org/schemas/contact-info.json",
      "$anchor": "contact_card",
      "type": "object",
      "required": [
        "email"
      ],
      "properties": {
        "email": {
          "type": "string",
          "format": "email"
        },
        "orcid": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/base_id"
    },
    {
      "type": "object",
      "required": [
        "submitted_date",
        "contact"
      ],
      "properties": {
        "priority": {
          "maximum": 10
        },
        "submitted_date": {
          "type": "string",
          "format": "date"
        },
        "contact": {
          "$ref": "https://example.org/schemas/contact-info.json",
          "required": [
            "department"
          ],
          "properties": {
            "department": {
              "type": "string"
            }
          }
        }
      }
    }
  ]
}
